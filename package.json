{
  "name": "pi-ui-extension",
  "version": "1.10.9",
  "type": "module",
  "description": "Pi terminal UI extension with session management, context inspection, Tool/MCP usage tracking, sidebar panels, and a compact footer",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "coding-agent",
    "terminal-ui",
    "tui",
    "mcp",
    "context-window"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "image": "https://github.com/1993yihuan/pi-ui-extension/releases/download/v1.7.1/preview.png"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm test && npm run check:docs && npm run check:package",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^22.19.19",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "undici": "^8.12.2"
  },
  "files": [
    "extensions",
    "!extensions/**/*.test.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1993yihuan/pi-ui-extension.git"
  },
  "homepage": "https://github.com/1993yihuan/pi-ui-extension#readme",
  "bugs": {
    "url": "https://github.com/1993yihuan/pi-ui-extension/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
